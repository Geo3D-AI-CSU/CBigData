{
  "providers": {
    "priority": ["gee", "demo"],
    "gee": {
      "enabled": true,
      "displayName": "Google Earth Engine",
      "description": "Google Earth Engine 服务账号（已配置）",
      "setupUrl": "https://developers.google.com/earth-engine/guides/service_account",
      "credentials": {
        "serviceAccountKey": "cbigdata-gee-605ad04eea1d.json",
        "privateKey": ""
      }
    },
    "copernicus": {
      "enabled": false,
      "displayName": "Copernicus Programme",
      "description": "需要 CDS API Key 或 Sentinel Hub 凭据",
      "setupUrl": "https://cds.climate.copernicus.eu/api-how-to",
      "credentials": {
        "cdsApiKey": "",
        "cdsApiUrl": "https://cds.climate.copernicus.eu/api",
        "sentinelHubInstanceId": "",
        "sentinelHubClientId": "",
        "sentinelHubClientSecret": ""
      }
    },
    "demo": {
      "enabled": true,
      "displayName": "Demo模拟数据",
      "description": "基于数学函数的湖南省模拟数据，无需外部凭据"
