    "baseUrl": "http://localhost:8080/geoserver",
    "username": "admin",
    "password": "geoserver",
    "workspace": "hunan"
  },
  "server": {
    "port": 3002,
    "corsOrigin": "http://localhost:8081"
  },
  "hunan": {
    "bbox": {
      "minLat": 24.6,
